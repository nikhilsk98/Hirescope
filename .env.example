# Copy to .env (gitignored). Every line is optional; values are never logged or shown on the dashboard.

# LinkedIn job-alert emails (read-only IMAP). Gmail: turn on 2-Step Verification, then create an app password
# at https://myaccount.google.com/apppasswords and paste it here (not your normal password).
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@example.com
# IMAP_APP_PASSWORD=
# IMAP_FOLDER=INBOX

# Optional aggregator (also set aggregator.enabled: true in inputs/preferences.yaml). One of:
# JSEARCH_API_KEY=        # RapidAPI JSearch
# SERPAPI_API_KEY=        # SerpAPI (Google Jobs engine)
